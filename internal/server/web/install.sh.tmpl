#!/bin/sh
# monitorrr agent installer.
#
# Detects this machine's OS and CPU architecture, fetches the matching agent
# build, and optionally installs it as a service. Generated by the monitorrr
# server, so the URL and enrollment token below are already filled in.
#
#   curl -fsSL "{{.ServerURL}}/install.sh?token=TOKEN" | sudo sh
#
# Flags:
#   --no-service      install the binary but do not register a service
#   --prefix DIR      install location (default /usr/local/bin)
set -eu

SERVER="{{.ServerURL}}"
TOKEN="{{.EnrollToken}}"
PREFIX="/usr/local/bin"
INSTALL_SERVICE=1

while [ $# -gt 0 ]; do
	case "$1" in
	--no-service) INSTALL_SERVICE=0 ;;
	--prefix) PREFIX="$2"; shift ;;
	--prefix=*) PREFIX="${1#*=}" ;;
	-h | --help) sed -n '2,14p' "$0"; exit 0 ;;
	*) echo "unknown option: $1" >&2; exit 2 ;;
	esac
	shift
done

die() { echo "error: $*" >&2; exit 1; }

# --- detect platform -------------------------------------------------------

os=$(uname -s)
case "$os" in
Linux) goos=linux ;;
Darwin) goos=darwin ;;
*) die "unsupported operating system: $os (this installer handles Linux and macOS; use the Windows tab on the Deployment page)" ;;
esac

arch=$(uname -m)
case "$arch" in
x86_64 | amd64) goarch=amd64 ;;
aarch64 | arm64) goarch=arm64 ;;
*) die "unsupported architecture: $arch" ;;
esac

binary="monitorrr-agent-${goos}-${goarch}"
echo "detected ${goos}/${goarch} — installing ${binary}"

# --- fetch -----------------------------------------------------------------

if command -v curl >/dev/null 2>&1; then
	fetch() { curl -fsSL "$1" -o "$2"; }
elif command -v wget >/dev/null 2>&1; then
	fetch() { wget -q "$1" -O "$2"; }
else
	die "neither curl nor wget is available"
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

if ! fetch "${SERVER}/download/${binary}?token=${TOKEN}" "$tmp/monitorrr-agent"; then
	die "could not download ${binary}.
  The server has no build for ${goos}/${goarch}. Run 'make build-all' where the
  server lives, then re-run this installer."
fi
chmod +x "$tmp/monitorrr-agent"

# Gatekeeper quarantines anything fetched over the network on macOS.
if [ "$goos" = "darwin" ]; then
	xattr -d com.apple.quarantine "$tmp/monitorrr-agent" 2>/dev/null || true
fi

# --- install ---------------------------------------------------------------

if [ ! -w "$PREFIX" ] && [ "$(id -u)" -ne 0 ]; then
	die "$PREFIX is not writable — re-run with sudo, or pass --prefix DIR"
fi

mkdir -p "$PREFIX"
install -m 0755 "$tmp/monitorrr-agent" "$PREFIX/monitorrr-agent"
echo "installed $PREFIX/monitorrr-agent"

# A machine retired earlier carries a marker that stops the agent enrolling.
# Installing is an explicit decision to bring it back, so clear it.
if [ "$goos" = "darwin" ]; then
	state_dir="/Library/Application Support/monitorrr"
else
	state_dir="/var/lib/monitorrr"
fi
if [ -f "$state_dir/retired" ]; then
	rm -f "$state_dir/retired"
	echo "cleared the previous retirement marker in $state_dir"
fi

if [ "$INSTALL_SERVICE" -eq 0 ]; then
	echo
	echo "Run it with:"
	echo "  $PREFIX/monitorrr-agent -server $SERVER -enroll-token $TOKEN"
	exit 0
fi

if [ "$(id -u)" -ne 0 ]; then
	echo
	echo "Not running as root, so no service was registered."
	echo "Run it in the foreground with:"
	echo "  $PREFIX/monitorrr-agent -server $SERVER -enroll-token $TOKEN"
	exit 0
fi

# --- register a service ----------------------------------------------------

if [ "$goos" = "linux" ]; then
	command -v systemctl >/dev/null 2>&1 || die "systemd not found — install the service manually, or re-run with --no-service"

	cat >/etc/systemd/system/monitorrr-agent.service <<EOF
[Unit]
Description=monitorrr agent
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=$PREFIX/monitorrr-agent -server $SERVER -enroll-token $TOKEN
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

	systemctl daemon-reload
	systemctl enable --now monitorrr-agent
	echo "systemd service started — check it with: systemctl status monitorrr-agent"
else
	plist=/Library/LaunchDaemons/io.monitorrr.agent.plist
	cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.monitorrr.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>$PREFIX/monitorrr-agent</string>
    <string>-server</string><string>$SERVER</string>
    <string>-enroll-token</string><string>$TOKEN</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict>
</plist>
EOF

	launchctl unload "$plist" 2>/dev/null || true
	launchctl load -w "$plist"
	echo "launchd daemon started — check it with: launchctl list | grep monitorrr"
fi

echo
echo "Done. This device should appear on the dashboard within a few seconds."
