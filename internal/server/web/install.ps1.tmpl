# monitorrr agent installer for Windows.
#
# Detects this machine's CPU architecture, fetches the matching agent build,
# installs it to a fixed location, and registers a scheduled task that runs it
# as SYSTEM at boot. Generated by the monitorrr server, so the URL and
# enrollment token below are already filled in.
#
#   irm "{{.ServerURL}}/install.ps1?token=TOKEN" | iex
#
# To pass flags, create the script block yourself:
#
#   & ([scriptblock]::Create((irm "{{.ServerURL}}/install.ps1?token=TOKEN"))) -NoService
#
# Flags:
#   -NoService        install the binary but do not register the scheduled task
#   -Prefix DIR       install location (default C:\Program Files\monitorrr)

[CmdletBinding()]
param(
    [switch]$NoService,
    [string]$Prefix = "C:\Program Files\monitorrr"
)

$ErrorActionPreference = "Stop"

$Server = "{{.ServerURL}}"
$Token  = "{{.EnrollToken}}"
$TaskName = "monitorrr-agent"
$Target = Join-Path $Prefix "monitorrr-agent.exe"

# throw rather than exit: this script is normally run as "irm ... | iex", where
# it shares the session with whoever ran it, and exit would close their window
# along with the error message they need to read.
function Die($message) {
    throw "monitorrr install failed: $message"
}

# --- checks ----------------------------------------------------------------

$identity = [Security.Principal.WindowsIdentity]::GetCurrent()
$principal = New-Object Security.Principal.WindowsPrincipal($identity)
if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Die "run this in an elevated PowerShell. The agent installs under Program Files, writes its identity to ProgramData, and registers a task that runs as SYSTEM."
}

# --- detect platform -------------------------------------------------------

# PROCESSOR_ARCHITECTURE describes the current process, not the machine: a
# 32-bit PowerShell on a 64-bit Windows reports x86 and sets ARCHITEW6432 to
# the truth. Preferring the latter is what stops an ARM64 VM being handed an
# amd64 build.
$archRaw = $env:PROCESSOR_ARCHITEW6432
if (-not $archRaw) { $archRaw = $env:PROCESSOR_ARCHITECTURE }

switch ($archRaw) {
    "ARM64" { $goarch = "arm64" }
    "AMD64" { $goarch = "amd64" }
    default { Die "unsupported architecture: $archRaw" }
}

$binary = "monitorrr-agent-windows-$goarch.exe"
Write-Host "detected windows/$goarch - installing $binary"

# --- fetch -----------------------------------------------------------------

# Windows Server and older builds still default to TLS 1.0 here, which every
# current server refuses.
try {
    [Net.ServicePointManager]::SecurityProtocol =
        [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
} catch {}

$tmp = Join-Path $env:TEMP "monitorrr-agent-$([guid]::NewGuid().ToString('N')).exe"
try {
    Invoke-WebRequest -UseBasicParsing -Uri "$Server/download/$($binary)?token=$Token" -OutFile $tmp
} catch {
    Die "could not download $binary. The server may have no build for windows/$goarch - run 'make build-all' where the server lives, then re-run this installer.`n  $($_.Exception.Message)"
}

# Anything fetched over the network carries a mark-of-the-web stream that makes
# SmartScreen prompt on every launch, which a task running as SYSTEM cannot
# answer.
Unblock-File -Path $tmp -ErrorAction SilentlyContinue

# --- install ---------------------------------------------------------------

# Windows refuses to overwrite a running image, so an upgrade over an existing
# installation has to stop the task and wait for the process to actually go.
if (Get-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue) {
    Write-Host "stopping the existing $TaskName task"
    Stop-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue
    for ($i = 0; $i -lt 20; $i++) {
        if (-not (Get-Process -Name "monitorrr-agent" -ErrorAction SilentlyContinue)) { break }
        Start-Sleep -Milliseconds 500
    }
}

New-Item -ItemType Directory -Force -Path $Prefix | Out-Null
try {
    Copy-Item -Path $tmp -Destination $Target -Force
} catch {
    Die "could not write $Target - a running agent may still be holding it.`n  $($_.Exception.Message)"
}
Remove-Item -Path $tmp -Force -ErrorAction SilentlyContinue
Write-Host "installed $Target"

# A machine retired earlier carries a marker that stops the agent enrolling.
# Installing is an explicit decision to bring it back, so clear it.
$stateDir = Join-Path $env:ProgramData "monitorrr"
$marker = Join-Path $stateDir "retired"
if (Test-Path $marker) {
    Remove-Item -Path $marker -Force
    Write-Host "cleared the previous retirement marker in $stateDir"
}

if ($NoService) {
    Write-Host ""
    Write-Host "No scheduled task was registered. Run it with:"
    Write-Host "  & '$Target' -server $Server -enroll-token $Token"
} else {

    # --- register the scheduled task ---------------------------------------

    # A scheduled task rather than a Windows service: a real service needs a
    # service-control wrapper in the binary, and this needs to stay one static
    # executable with no Windows-only surface.
    #
    # -force-enroll is deliberately absent from the task arguments. An agent
    # that forced enrolment on every start would resurrect itself as a new
    # device if it were ever retired and the uninstall failed.
    $action = New-ScheduledTaskAction -Execute $Target `
        -Argument "-server $Server -enroll-token $Token"

    # Two triggers, because a scheduled task is a weaker supervisor than
    # systemd or launchd and the difference is not obvious.
    #
    # RestartCount only covers a task that *fails*. The agent exits zero on
    # purpose after replacing its own binary, expecting to be restarted - which
    # systemd (Restart=always) and launchd (KeepAlive) both do, and which
    # restart-on-failure does not. Without the repeating trigger, an agent that
    # auto-updates stays dead until the machine reboots.
    #
    # The repetition also covers a clean exit for any other reason. Task
    # Scheduler will not start a second copy while one is running, and an agent
    # that has been retired leaves a marker that makes it exit immediately, so
    # neither duplicates nor resurrected machines are a risk here.
    $triggers = @(
        (New-ScheduledTaskTrigger -AtStartup),
        (New-ScheduledTaskTrigger -Once -At (Get-Date) -RepetitionInterval (New-TimeSpan -Minutes 1))
    )

    $taskPrincipal = New-ScheduledTaskPrincipal -UserId "SYSTEM" -LogonType ServiceAccount -RunLevel Highest

    # ExecutionTimeLimit defaults to three days for a task created this way,
    # after which Task Scheduler stops it. Zero means no limit, which is what a
    # process meant to run forever needs.
    $settings = New-ScheduledTaskSettingsSet `
        -RestartCount 999 -RestartInterval (New-TimeSpan -Minutes 1) `
        -ExecutionTimeLimit ([TimeSpan]::Zero) `
        -MultipleInstances IgnoreNew `
        -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries

    Register-ScheduledTask -TaskName $TaskName -Action $action -Trigger $triggers `
        -Principal $taskPrincipal -Settings $settings -Force | Out-Null
    Start-ScheduledTask -TaskName $TaskName

    Write-Host "scheduled task started - check it with: Get-ScheduledTask -TaskName $TaskName"
    Write-Host ""
    Write-Host "Done. This device should appear on the dashboard within a few seconds."
}
